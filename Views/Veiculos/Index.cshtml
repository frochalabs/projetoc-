@model IEnumerable<MVC.Dev._2023.Models.Veiculo>

@{
    ViewData["Title"] = "Lista de Veículos";
}

<h1>Lista de Veículos</h1>

<p>
    <a asp-action="Create" class="btn btn-success">Adicionar Veículo</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Nome)</th>
            <th>@Html.DisplayNameFor(model => model.Placa)</th>
            <th>@Html.DisplayNameFor(model => model.AnoFabricacao)</th>
            <th>@Html.DisplayNameFor(model => model.AnoModelo)</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@Html.DisplayFor(modelItem => item.Nome)</td>
            <td>@Html.DisplayFor(modelItem => item.Placa)</td>
            <td>@Html.DisplayFor(modelItem => item.AnoFabricacao)</td>
            <td>@Html.DisplayFor(modelItem => item.AnoModelo)</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning">Editar</a>
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info">Visualizar</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger">Excluir</a>
            </td>
        </tr>
}
    </tbody>
</table>